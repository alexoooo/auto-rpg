+
+    /// Sets the signed bounds of the motor's force along `axis`, from `minForce` (zero or less)
+    /// to `maxForce` (zero or more). The force is the one the motor applies to the first body:
+    /// a negative force turns the second body toward the axis's positive sense.
+    pub fn jointSetMotorForceBounds(
+        &mut self,
+        handle: FlatHandle,
+        axis: RawJointAxis,
+        minForce: f32,
+        maxForce: f32,
+    ) {
+        self.map_mut(handle, |j| {
+            j.data
+                .set_motor_force_bounds(axis.into(), minForce, maxForce);
+        })
+    }
+
+    /// The impulse the motor along `axis` applied to the first body in the last solver substep
+    /// (its force times the substep): the second body was given its negative.
+    pub fn jointMotorImpulse(&self, handle: FlatHandle, axis: RawJointAxis) -> f32 {
+        self.map(handle, |j| j.data.motors[axis as usize].impulse)
+    }
+
+    /// The impulse the limit along `axis` applied to the first body in the last solver substep.
+    pub fn jointLimitImpulse(&self, handle: FlatHandle, axis: RawJointAxis) -> f32 {
+        self.map(handle, |j| j.data.limits[axis as usize].impulse)
+    }
+
+    /// The impulse holding the locked `axis`, on the first body, in the last solver substep.
+    pub fn jointLockedImpulse(&self, handle: FlatHandle, axis: RawJointAxis) -> f32 {
+        self.map(handle, |j| j.impulses[axis as usize])
+    }
 }
