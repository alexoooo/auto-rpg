{
  "name": "auto-rpg-warrior-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/turntable-state.test.mjs tests/experiment-state.test.mjs tests/viewer-readiness.test.mjs tests/viewer-assets.test.mjs && npm run check:visuals && npm run build && node --test tests/rendered-html.test.mjs",
    "check:visuals": "node scripts/check-visual-evidence.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern metric/.venv --ignore-pattern .metric-cache",
    "asset:build": "node scripts/run-blender.mjs",
    "asset:validate": "node scripts/validate-asset.mjs",
    "asset:v2:build": "node scripts/build-warrior-v2.mjs",
    "asset:v2:validate": "node scripts/validate-warrior-v2.mjs",
    "asset:v3:build": "node scripts/build-warrior-v3.mjs",
    "asset:v3:spike:basemesh": "node scripts/spike-basemesh.mjs",
    "asset:v3:spike:harness": "node scripts/spike-harness.mjs",
    "asset:v3:validate": "node scripts/validate-warrior-v3.mjs",
    "asset:v3:screen:authored": "node scripts/build-warrior-v3.mjs --screen",
    "asset:v3:screen": "node scripts/screen-warrior-variants.mjs",
    "asset:v3:screen:body": "node scripts/screen-body-variants.mjs",
    "asset:v3:screen:torso": "node scripts/screen-torso-variants.mjs",
    "asset:v3:screen:shield": "node scripts/screen-shield-variants.mjs",
    "asset:v3:screen:texture": "node scripts/screen-texture-variants.mjs",
    "asset:v3:screen:distance": "node scripts/run-metric.mjs screen-distance",
    "similarity:setup": "node scripts/run-metric.mjs setup",
    "similarity:render": "node scripts/render-review.mjs",
    "similarity": "npm run similarity:render && node scripts/run-metric.mjs score",
    "similarity:classical": "npm run similarity:render && node scripts/run-metric.mjs score --classical",
    "similarity:v1": "npm run similarity",
    "similarity:v2:prepare": "npm run similarity:render && node scripts/run-metric.mjs prepare-v2",
    "similarity:v3:prepare": "npm run similarity:render && node scripts/audit-region-ownership.mjs",
    "similarity:v4:prepare": "node scripts/run-metric.mjs prepare-v4",
    "similarity:v5:prepare": "node scripts/run-metric.mjs prepare-v5",
    "similarity:v5": "npm run similarity:render && set WARRIOR_REFERENCE_PROFILE=rigid-v5&& node scripts/run-metric.mjs score-v2",
    "similarity:v4": "npm run similarity:render && node scripts/run-metric.mjs score-v4",
    "similarity:v3": "npm run similarity:render && set WARRIOR_REFERENCE_PROFILE=rigid-v3&& node scripts/run-metric.mjs score-v2",
    "similarity:v2": "npm run similarity:render && node scripts/run-metric.mjs score-v2",
    "similarity:v2:classical": "npm run similarity:render && node scripts/run-metric.mjs score-v2 --classical",
    "similarity:atlas": "node scripts/run-metric.mjs score-v2",
    "similarity:compare": "node scripts/compare-similarity.mjs",
    "similarity:compare:report": "node scripts/run-metric.mjs comparisons",
    "similarity:v2:calibrate": "node scripts/run-metric.mjs calibrate-v2",
    "similarity:experiment:snapshot": "node scripts/snapshot-similarity-experiment.mjs",
    "similarity:experiment:decide": "node scripts/decide-similarity-experiment.mjs",
    "similarity:experiment:audit": "node scripts/audit-similarity-experiments.mjs",
    "similarity:phase:contact-sheet": "node scripts/run-metric.mjs archive-progress",
    "similarity:phase:archive": "node scripts/archive-similarity-phase.mjs",
    "similarity:test": "node scripts/run-metric.mjs test"
  },
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "@babylonjs/loaders": "9.18.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
