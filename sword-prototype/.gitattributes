# both files and `scripts/derive-kaykit-knight.mjs` that wrote them, so the patterns matched nothing.
# `docs/deleted-paths.md` is where those paths are on record. The `asset-src/armour/kaykit-*` lines
# below stay, because those four extracts are still tracked -- checked with `git ls-files`, not
# assumed.
asset-src/armour/**/*.obj text eol=lf
asset-src/armour/**/LICENSE.txt text eol=lf
asset-src/armour/**/SOURCE.txt text eol=lf
asset-src/armour/kaykit-adventurers-1.0/*.glb binary
asset-src/armour/kaykit-adventurers-1.0/*.json text eol=lf
