{
  "name": "auto-rpg-sword-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "measure": "node scripts/measure.mjs",
    "measure:engagement": "node scripts/measure-engagement.mjs",
    "ai:evaluate": "node scripts/evaluate-ai.mjs",
    "ai:research": "node scripts/research-runner.mjs",
    "ai:preflight": "node scripts/research-preflight.mjs",
    "ai:measure-ppo-workers": "node scripts/measure-ppo-workers.mjs",
    "ai:watch": "node scripts/watch-research.mjs",
    "asset:build": "node scripts/run-blender.mjs",
    "asset:review": "node scripts/run-blender.mjs --review",
    "asset:verify": "node scripts/run-blender.mjs --verify",
    "asset:qualify": "node scripts/qualify-humanoid.mjs",
    "asset:dimensions": "node scripts/run-blender.mjs --dimensions",
    "asset:fetch": "node scripts/fetch-polyhaven.mjs",
    "texture:fetch": "node scripts/fetch-textures.mjs",
    "texture:verify": "node scripts/fetch-textures.mjs --verify",
    "armour:fetch": "node scripts/fetch-armour.mjs",
    "armour:verify": "node scripts/fetch-armour.mjs --verify",
    "armour:extract": "node scripts/extract-armour.mjs",
    "kaykit:derive": "node scripts/derive-kaykit-knight.mjs",
    "kaykit:verify": "node scripts/derive-kaykit-knight.mjs --verify"
  },
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.18.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
