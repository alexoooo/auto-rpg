{
  "question": "Does an explicit numeric movement keep a finite positive obedience price when the measuring path removes its gait envelope?",
  "harness": {
    "runtime": "Node stand",
    "world": "src/core/world/world.ts",
    "engine": "rapier",
    "rateHz": 120,
    "script": "research/skills/locomotion/locomotion-run.mjs"
  },
  "arguments": [
    "--models",
    "workshop-fighter",
    "--holds",
    "empty",
    "--tracks",
    "forward",
    "--paces",
    "0.7",
    "--seeds",
    "1",
    "--winds",
    "0:0",
    "--seconds",
    "3",
    "--workers",
    "1"
  ],
  "modes": {
    "measuring": "default; Experiment.measuring is true",
    "played": "--played; the measured gait envelope is available"
  },
  "rows": {
    "measuring": {
      "before": "measuring-before.jsonl",
      "after": "measuring-after.jsonl"
    },
    "played": {
      "before": "played-before.jsonl",
      "after": "played-after.jsonl"
    }
  },
  "provenance": "Bounded diagnostic rows identify their harness and scenario; source build identities are unrecorded."
}
