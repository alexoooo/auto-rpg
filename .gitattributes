# Text is LF in every working copy; Git decides what is text and keeps it so.
* text=auto eol=lf
# A patch's empty context line is a single space, not trailing whitespace.
*.patch whitespace=-blank-at-eol
# Blender masters and the original art are kept in Git LFS.
*.blend filter=lfs diff=lfs merge=lfs -text
assets/art/textures/** filter=lfs diff=lfs merge=lfs -text
assets/art/environment/** filter=lfs diff=lfs merge=lfs -text
