# Files whose bytes another tool reads as LF: bash runs a script, and `git apply` applies a patch
# to a clone with LF sources. They stay LF in every working copy, whatever core.autocrlf says.
*.sh text eol=lf
# An empty context line in a unified patch consists of its single-space marker.
*.patch text eol=lf whitespace=-blank-at-eol
# An evaluation record is kept byte for byte: its provenance names the SHA-256 of its LF bytes.
assets/evaluations/** text eol=lf
# Editable character masters and the shared original texture library.
assets/character-lab/*.blend filter=lfs diff=lfs merge=lfs -text
assets/art/textures/** filter=lfs diff=lfs merge=lfs -text
# Full-quality environment inputs are shared by generated web delivery and authoring tools.
assets/art/environment/** filter=lfs diff=lfs merge=lfs -text
assets/forge/*.blend filter=lfs diff=lfs merge=lfs -text
assets/dungeon-reference/*.blend filter=lfs diff=lfs merge=lfs -text
assets/crypt-kit/*.blend filter=lfs diff=lfs merge=lfs -text
assets/skeleton/*.blend filter=lfs diff=lfs merge=lfs -text
