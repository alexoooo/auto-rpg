+#[derive(Default)]
+struct RejectSweep(std::sync::atomic::AtomicUsize);
+impl PhysicsHooks for RejectSweep {
+    fn filter_contact_pair(&self, _: &PairFilterContext) -> Option<SolverFlags> {
+        self.0.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        None
+    }
+}
+
+#[test]
+fn ccd_only_hook_filters_sweeps() {
+    let mut h = Harness::new();
+    insert_thin_fixed_wall(&mut h);
+    let body = insert_fast_dynamic(&mut h, false);
+    let collider = h.bodies[body].colliders()[0];
+    h.colliders[collider].set_active_hooks(ActiveHooks::FILTER_CCD_PAIRS);
+    let hooks = RejectSweep::default();
+    h.step_with_hooks(&hooks);
+    assert!(hooks.0.load(std::sync::atomic::Ordering::Relaxed) > 0);
+    assert!(h.x(body) > 0.0, "the excluded wall clamped the sweep");
+}
+
+#[test]
+fn ccd_only_hook_preserves_discrete_contacts_and_recycling() {
+    let run = |flags| {
+        let mut h = Harness::new();
+        h.gravity = Vector::new(0.0, -9.81, 0.0);
+        h.colliders.insert(ColliderBuilder::cuboid(5.0, 0.5, 5.0)
+            .translation(Vector::new(0.0, -0.5, 0.0)));
+        let body = h.bodies.insert(RigidBodyBuilder::dynamic()
+            .translation(Vector::new(0.0, 1.0, 0.0)).can_sleep(false));
+        h.colliders.insert_with_parent(ColliderBuilder::cuboid(0.5, 0.5, 0.5)
+            .active_hooks(flags), body, &mut h.bodies);
+        let hooks = RejectSweep::default();
+        let mut trace = Vec::new();
+        for _ in 0..240 {
+            h.step_with_hooks(&hooks);
+            trace.push((*h.bodies[body].position(), h.bodies[body].linvel()));
+        }
+        assert_eq!(hooks.0.load(std::sync::atomic::Ordering::Relaxed), 0,
+            "a CCD-only hook was called for a discrete contact");
+        assert!((h.bodies[body].translation().y - 0.5).abs() < 0.01);
+        trace
+    };
+    assert_eq!(run(ActiveHooks::empty()), run(ActiveHooks::FILTER_CCD_PAIRS));
+}
