+    pub fn accumulate_motor_impulses(&self, joints_all: &mut [JointGraphEdge]) {
+        if let WritebackId::Motor(i) = self.writeback_id {
+            let impulses: [_; SIMD_WIDTH] = self.impulse.into();
+            for lane in 0..SIMD_WIDTH {
+                // Padding repeats a joint: its impulse is applied only once.
+                if !self.joint_id[..lane].contains(&self.joint_id[lane]) {
+                    joints_all[self.joint_id[lane]].weight.data.motors[i].step_impulse +=
+                        impulses[lane];
+                }
+            }
+        }
+    }
 }
