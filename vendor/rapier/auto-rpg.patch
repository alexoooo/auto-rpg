+        let axis = JointAxis::AngX;
+        let mut data = GenericJoint::new(JointAxesMask::LOCKED_REVOLUTE_AXES);
+        data.set_contacts_enabled(false);
+        data.set_motor_velocity(axis, 10.0, Real::INFINITY);
+        data.set_motor_max_force(axis, 0.1);
+        let joint = world.insert_impulse_joint(parent, child, data);
+        world.step();
+        let first = world.impulse_joints.get(joint).unwrap().data.motors[axis as usize];
+        assert!((first.step_impulse + 0.1 * world.integration_parameters.dt as f64).abs() < 1.0e-8);
+        assert!((first.step_impulse + world.bodies[child].angvel().x as f64 * 0.1).abs() < 1.0e-8);
+        assert!(first.step_impulse.abs() > 8.0 * first.impulse.abs() as f64);
+        world
+            .impulse_joints
+            .get_mut(joint, true)
+            .unwrap()
+            .data
+            .set_motor_velocity(axis, 0.005, Real::INFINITY);
+        world.step();
+        let next = world.impulse_joints.get(joint).unwrap().data.motors[axis as usize];
+        assert!(next.step_impulse > 0.001 && next.impulse.abs() < 1.0e-8);
+        world.bodies[child].set_body_type(RigidBodyType::Fixed, true);
+        world.step();
+        assert_eq!(
+            world.impulse_joints.get(joint).unwrap().data.motors[axis as usize].step_impulse,
+            0.0
+        );
+    }
+    #[cfg(feature = "dim3")]
+    #[test]
+    fn step_motor_impulse_preserves_precision_across_substeps() {
+        use crate::prelude::*;
+        for count in [16, 32, 64, 128, 256, 512] {
+            let mut world = PhysicsWorld::default();
+            world.gravity = Vector::ZERO;
+            world.integration_parameters.num_solver_iterations = count;
+            let (parent, _) = world.insert(RigidBodyBuilder::fixed(), ColliderBuilder::ball(0.5));
+            let (child, _) = world.insert(
+                RigidBodyBuilder::dynamic().can_sleep(false),
+                ColliderBuilder::ball(0.5).mass(1.0),
+            );
+            let axis = JointAxis::AngX;
+            let mut data = GenericJoint::new(JointAxesMask::LOCKED_REVOLUTE_AXES);
+            data.set_contacts_enabled(false);
+            data.set_motor_velocity(axis, 1.0e6, Real::INFINITY);
+            data.set_motor_max_force(axis, 149.3);
+            let joint = world.insert_impulse_joint(parent, child, data);
+            world.step();
+            let motor = world.impulse_joints.get(joint).unwrap().data.motors[axis as usize];
+            assert_eq!(motor.step_impulse, motor.impulse as f64 * count as f64);
+        }
+    }
+
 }
