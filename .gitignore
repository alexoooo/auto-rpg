# Build output and installed dependencies.
node_modules/
dist/
.vite/
.test-build/

# Downloaded toolchains -- Blender and friends, fetched by the asset scripts. Large, and
# reproducible from the fetchers rather than from the repository.
.tools/

# Editor and agent state that belongs to one machine.
.idea/
.claude/settings.local.json
.claude/local/

# Python bytecode from the asset extractors.
__pycache__/
*.py[cod]

# MSYS crash artifacts. They appear at whatever directory a shell died in.
*.stackdump

# Scratch review output.
.review/
