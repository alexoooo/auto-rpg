# What the working copy keeps outside Git, one entry each; anything else untracked outside the
# tracked folders is a stray (scripts/workspace.mjs, tests/workspace.test.mjs).

# Build output and installed dependencies.
node_modules/
dist/

# The art pipeline's pinned encoders, downloads and builds, and the assets it generates
# (docs/art/assets.md).
.cache/art/
public/assets/generated/

# Disposable work: probes, logs, before-readings, screenshots in .tmp/<task>/, worktrees in
# .tmp/worktrees/<name>/. `npm run clean` deletes what is a day old.
.tmp/

# Toolchains, each by name and made as its user says; anything else in .tools/ is a stray.
# Blender, for the art pipeline (scripts/art/tools.mjs).
.tools/blender-*/
# MakeHuman's Blender plugin, for the realistic characters (docs/art/characters.md).
.tools/mpfb/
# Blender Studio's Human Base Meshes, the skeleton's source (docs/art/skeleton.md).
.tools/human-base-meshes/
# Python for training, on the CPU and with CUDA's torch (research/run-train.py).
.tools/ai-lab-venv/
.tools/ai-lab-cuda-venv/
# The Rapier build's checkout (vendor/rapier/build.sh), and a hand-patched checkout of it.
.tools/rapier-build/
.tools/rapier-source/

# Editor and agent state that belongs to one machine.
.idea/
.claude/settings.local.json
.claude/local/

# Python bytecode from the asset extractors and research scripts. `npm run clean` deletes it.
__pycache__/

# MSYS crash artifacts. They appear at whatever directory a shell died in; ignored so that none is
# committed, and garbage wherever they lie: `npm run clean` deletes them.
*.stackdump

# Research runs: what a later run reads, each folder's README.md naming it (AGENTS.md).
/research/runs/

# The stand-up research's recorded frames and run logs, kept beside its code (research/stand-controller/).
/research/stand-controller/c/view/*.json
/research/stand-controller/**/runs/
