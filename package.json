{
  "name": "auto-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "assets": "node scripts/art/assets.mjs build",
