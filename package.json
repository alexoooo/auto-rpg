    "@mujoco/mujoco": "4.0.0"
  },
  "devDependencies": {
    "@babel/generator": "8.1.0",
    "@babel/parser": "8.1.0",
    "@babylonjs/ktx2decoder": "9.35.0",
    "@gltf-transform/core": "4.5.1",
