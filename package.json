{
  "name": "auto-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets": "node scripts/art/assets.mjs build",
    "assets:check": "node scripts/art/assets.mjs check",
    "assets:report": "node scripts/art/assets.mjs report",
    "dev": "node scripts/art/assets.mjs build && vite",
    "build": "node scripts/art/assets.mjs build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "match": "node scripts/match.mjs",
    "clean": "node scripts/clean.mjs",
    "tournament": "node scripts/tournament.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "@babylonjs/loaders": "9.18.1",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@dimforge/rapier3d-simd-compat": "file:vendor/rapier/dimforge-rapier3d-simd-compat-0.21.0-auto-rpg.9.tgz",
    "@mujoco/mujoco": "3.14.0"
  },
  "devDependencies": {
    "@babylonjs/ktx2decoder": "9.18.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
