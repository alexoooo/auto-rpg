{
  "name": "auto-rpg-client",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "cargo build --release --target wasm32-unknown-unknown -p web && node node_modules/vite/bin/vite.js",
    "trace": "cargo run --release -p lab -- trace",
    "view": "node node_modules/vite/bin/vite.js",
    "generate:abi": "cargo run --quiet -p web --bin emit_abi -- --output client/src/protocol/abi.generated.ts",
    "check:abi": "node tools/check_abi.js",
    "check": "tsc --noEmit",
    "build": "cargo build --release --target wasm32-unknown-unknown -p web && node node_modules/vite/bin/vite.js build",
    "test:worker": "node --test client/test/worker-protocol.test.mjs",
    "test:wasm-memory": "node --test client/test/wasm-memory.test.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "@babylonjs/loaders": "9.18.1",
    "babylonjs-gltf2interface": "9.18.1"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
